[Unit]
Description=Shade Backend
After=network-online.target mongod.service
Wants=network-online.target mongod.service

[Service]
Type=simple
User=josh
Group=josh
WorkingDirectory=/opt/shade/src/backend
EnvironmentFile=/opt/shade/backend.env
Environment=PATH=/home/josh/.bun/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/home/josh/.bun/bin/bun run src/index.ts
Restart=on-failure
RestartSec=5
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal
SyslogIdentifier=shade-backend

[Install]
WantedBy=multi-user.target
