# Shade Worker Configuration
# Copy to ~/.config/shade/shade-worker.env and edit values
#
# The worker shares MongoDB and SHADE_DATA_DIR with the gateway (same host);
# coordination happens through the AgentTask board — no HTTP worker protocol.

NODE_ENV=production

# Worker health endpoint (GET /health)
WORKER_PORT=4021

# MongoDB (same instance as the gateway)
MONGO_URI=mongodb://localhost:27017/shade

# Anthropic
ANTHROPIC_API_KEY=

# Data directory — MUST match the gateway's SHADE_DATA_DIR (sessions, groups,
# ipc); IPC files written by worker-run agents are picked up by the gateway.
# macOS default: ~/Library/Application Support/Shade/data
# Linux default: ~/.local/share/shade/data
SHADE_DATA_DIR=
