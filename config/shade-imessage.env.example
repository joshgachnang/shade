# Shade iMessage Edge Agent Configuration
# Copy to ~/.config/shade/shade-imessage.env and edit values
#
# Runs the same shade.js bundle as the backend with SHADE_SERVICE=imessage
# (set automatically by the service definition). Reads ~/Library/Messages/chat.db,
# so the process needs macOS Full Disk Access (System Settings > Privacy &
# Security > Full Disk Access > add bun).

NODE_ENV=production

# Shade gateway this agent registers with and pushes messages to
SHADE_URL=http://localhost:4020

# Must match the backend's SHADE_BOOTSTRAP_SECRET (copied from
# shade-backend.env by `shade install imessage` if left empty)
SHADE_BOOTSTRAP_SECRET=

# Agent name shown in the fleet UI (defaults to imessage-<hostname>)
SHADE_AGENT_NAME=
